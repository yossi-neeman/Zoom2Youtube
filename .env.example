# Zoom API Credentials
ZOOM_ACCOUNT_ID=your-account-id-here
ZOOM_CLIENT_ID=your-client-id-here
ZOOM_CLIENT_SECRET=your-client-secret-here

# Web App Authentication (Optional)
# Set AUTH_ENABLED=false to disable authentication
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Admin sign-in method: password (default) | google | both
AUTH_MODE=password
# Google sign-in (only identifies admins; unrelated to the YouTube upload account).
# Create an OAuth client of type "Web application" with redirect URI https://<your-domain>/auth/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Optional: override the redirect URI (otherwise derived from the request; set TRUST_PROXY=true behind a proxy)
# GOOGLE_LOGIN_REDIRECT_URI=https://zoom.example.com/auth/callback
# Who may sign in with Google: comma-separated emails and/or whole domains
ADMIN_EMAILS=alice@gmail.com,bob@gmail.com
# ADMIN_DOMAINS=yourorg.org

# Optional: lets a scheduled job (e.g. GitHub Actions cron) call /api/* with
# "Authorization: Bearer <API_TOKEN>" instead of logging in. At least 24 characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=

# Flask Secret Key (Optional - auto-generated if not set)
SECRET_KEY=your-random-secret-key-here
